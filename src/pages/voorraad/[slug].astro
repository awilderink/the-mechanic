---
import { PortableText } from 'astro-portabletext';
import type { GetStaticPaths } from 'astro';
import Button from '../../components/Button.astro';
import FeaturedVoorraad from '../../components/FeaturedVoorraad.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVoorraad, getVoorraadItem, urlFor } from '../../sanity/index.ts';
import Accordion, { type AccordionEntry } from '../../solid/Accordion';
import GalleryMain from '../../solid/GalleryMain';
import GalleryThumbs from '../../solid/GalleryThumbs';
import type { Img } from '../../solid/types';

export const prerender = true;

const { slug } = Astro.params;

export const getStaticPaths: GetStaticPaths = async () => {
	const voorraadItems = await getVoorraad();
	return voorraadItems.map((item) => ({
		params: { slug: item.slug?.current },
		props: { item },
	}));
};

const item = await getVoorraadItem(String(slug));

if (!item) {
	return Astro.redirect('/404');
}

const fotos: Img[] = (item.fotos ?? [])
	.filter((foto) => foto.asset?._ref)
	.map((foto) => ({
		src: urlFor(foto.asset!._ref).width(1600).height(1000).quality(75).format('webp').url(),
		alt: `${item.merk?.naam ?? ''} ${item.titel ?? ''}`.trim(),
		width: 1600,
		height: 1000,
	}));

const specificaties: AccordionEntry[] = (item.specificaties ?? []).map(({ label, waarde }) => ({
	title: label ?? '',
	html: waarde ?? '',
}));
---

<style>
  .car-grid {
    grid-template-areas:
      "images"
      "title"
      "thumbnails"
      "details"
      "actions"
      "info";
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .car-grid {
      grid-template-areas:
        "images title"
        "images thumbnails"
        "images details"
        "info   details";
      grid-template-columns: 6fr 4fr;
      grid-template-rows: auto auto 1fr auto;
    }
  }
</style>
<BaseLayout>
  <section class="p-4">
    <div
      class="car-grid container mx-auto grid max-w-6xl gap-4 pt-24 md:flex-row md:gap-10"
    >
      {/* transition:name must sit on a real Astro element: an <astro-island>
          is display:contents and has no box to fly. */}
      <div
        class="relative overflow-hidden rounded-xl [grid-area:images]"
        transition:name={item.fotos?.[0]._key}
      >
        <GalleryMain
          client:load
          galleryId={item._id}
          images={fotos}
          arrowClass="text-primary"
        />
      </div>

      <div class="min-w-0 [grid-area:title]">
        <h1 class="text-primary text-2xl md:text-4xl">
          {item.merk?.naam}{" "}
          {item.titel}
        </h1>
      </div>

      <div class="mt-2 min-w-0 [grid-area:thumbnails]">
        <GalleryThumbs
          client:load
          galleryId={item._id}
          images={fotos}
          thumbBasis="basis-1/8"
        />
      </div>
      <div class="relative mt-2 flex flex-col [grid-area:details]">
        <div class="sticky top-8 z-10">
          <!-- {
            item?.highlight && (
              <Title variant="tertiary" class="text-primary mb-2">
                {voorraadItem.highlight}
              </Title>
            )
          } -->
          <div>
            <dl
              class="[&_dd]:text-primary grid grid-cols-2 gap-6 font-light md:grid-cols-3 [&_dt]:text-neutral-500"
            >
              <div>
                <dt>Bouwjaar</dt>
                <dd>{item.bouwjaar}</dd>
              </div>
              <div>
                <dt>Km stand</dt>
                <dd>
                  {
                    Intl.NumberFormat("nl-NL").format(
                      Number(item.kilometerstand)
                    )
                  } km
                </dd>
              </div>
              <div>
                <dt>Prijs</dt>
                <dd>
                  {
                    Intl.NumberFormat("nl-NL", {
                      currency: "EUR",
                      style: "currency",
                    }).format(Number(item.prijs))
                  }
                </dd>
              </div>
              <div>
                <dt>Brandstof</dt>
                <dd class="capitalize">{item.brandstof}</dd>
              </div>
              <!-- <div>
                <dt>Motorinhoud</dt>
                <dd>{item.motor_inhoud}</dd>
              </div> -->
              <!-- <div>
                <dt>Kleur</dt>
                <dd>{item.kleur}</dd>
              </div> -->
            </dl>
          </div>
          <div class="mt-4 flex flex-col gap-2">
            <Button class="flex items-center justify-center gap-2 font-thin">
              <Icon class="mr-2 h-4 w-4" name="phone" />
              <span>070 8209890</span>
            </Button>
            <Button
              class="flex items-center justify-center gap-2 font-thin"
              variant="secondary"
            >
              <Icon name="email" class="mr-2 h-4 w-4" />
              info@themechanic.nl
            </Button>
          </div>
        </div>
      </div>
      <div class="container mx-auto mt-10 max-w-6xl [grid-area:info]">
        <div class="flex items-center justify-between">
          <h1 class="text-4xl">{item.merk?.naam}{" "}{item.titel}</h1>
          <div class="flex gap-1">
            <Icon name="linkedIn" class="size-9" />
            <Icon name="facebook" class="size-9" />
            <Icon name="instagram" class="size-9" />
          </div>
        </div>
        {
          item.beschrijving && (
            <div
              class="mt-8 max-w-3xl space-y-4 font-light [&_a]:underline [&_h2]:text-xl [&_h3]:text-lg [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"
            >
              <PortableText value={item.beschrijving} />
            </div>
          )
        }
        {
          specificaties.length > 0 && (
            <Accordion client:visible items={specificaties} openFirst class="mt-8" />
          )
        }
      </div>
    </div>
  </section>
  <section class="bg-sand px-4 py-14">
    <div class="container mx-auto max-w-6xl">
      <FeaturedVoorraad exclude={item.slug?.current} />
    </div>
  </section>
</BaseLayout>
