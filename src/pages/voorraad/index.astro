---
import Button from '../../components/Button.astro';
import HeroImageSection from '../../components/blocks/HeroImageSection.astro';
import SanityImage from '../../components/SanityImage.astro';
import Title from '../../components/Title.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGlobal, getMerken, getVoorraad } from '../../sanity';
import VoorraadFilters from '../../solid/VoorraadFilters';

const { searchParams } = Astro.url;

const selectedMerk = searchParams.get('merk');
const selectedVerkocht = searchParams.get('verkocht') ?? 'false';
const merken = await getMerken();
const global = await getGlobal();
const merkOpties = merken
	.filter((merk) => merk.naam)
	.map((merk) => ({ value: merk.naam!, label: merk.naam! }));

const voorraadItems = await getVoorraad({
	...(selectedMerk && { merk: selectedMerk }),
	verkocht: selectedVerkocht === 'true',
});
---

<BaseLayout
  title="Voorraad"
  description="De voorraad van de The Mechanic"
  seo={global?.voorraadSeo}
>
  <div class="bg-sand min-h-dvh pb-4 pt-20 md:pt-28">
    {
      global?.voorraadHero && (
        <HeroImageSection
          block={{
            _type: "heroImageSection",
            image: global.voorraadHero,
            alt: "Aanbod van The Mechanic",
          }}
        />
      )
    }
    <div class="container mx-auto max-w-6xl px-4">
      <VoorraadFilters
        client:load
        merken={merkOpties}
        merk={selectedMerk ?? ""}
        verkocht={selectedVerkocht ?? ""}
      />

      <div id="results" class="flex flex-col gap-8">
        {
          voorraadItems.length ? (
            voorraadItems.map((item) => {
              return (
                <a href={`/voorraad/${item.slug!.current}`}>
                  <div class="flex flex-col overflow-hidden rounded-2xl bg-white md:flex-row">
                    <div
                      class="aspect-[4/3] shrink-0 basis-1/2 overflow-hidden"
                      transition:name={item._id}
                    >
                      <SanityImage
                        image={item.fotos?.[0].asset!._ref}
                        alt={item.titel!}
                        width={400}
                        height={300}
                        class="h-full w-full object-cover"
                      />
                    </div>
                    <div class="min-w-0 basis-1/2 space-y-6 px-8 py-12">
                      <Title class="text-primary text-2xl" variant="tertiary">
                        {item.merk?.naam}&nbsp;{item.titel}
                      </Title>
                      {/* <p class="text-sm font-light text-pretty">
                        {item.highlight}
                      </p> */}
                      <div class="mt-2 grid grid-cols-3">
                        <div class="space-y-1">
                          <dt class="text-neutral-400">Bouwjaar</dt>
                          <dd class="font-light">{item.bouwjaar ?? "—"}</dd>
                        </div>
                        <div class="space-y-1">
                          <dt class="text-neutral-400">Km stand</dt>
                          <dd class="font-light">
                            {item.kilometerstand != null
                              ? `${Intl.NumberFormat("nl-NL").format(item.kilometerstand)} km`
                              : "—"}
                          </dd>
                        </div>
                        <div class="space-y-1">
                          <dt class="text-neutral-400">Prijs</dt>
                          <dd class="font-light">
                            {item.prijs
                              ? Intl.NumberFormat("nl-NL", {
                                  style: "currency",
                                  currency: "EUR",
                                }).format(item.prijs)
                              : "Op aanvraag"}
                          </dd>
                        </div>
                      </div>
                      <Button
                        size="sm"
                        class="w-full cursor-pointer md:w-auto"
                        variant="primary"
                      >
                        Bekijk model
                      </Button>
                    </div>
                  </div>
                </a>
              );
            })
          ) : (
            <div class="w-full py-12 text-center">
              <p>Geen voertuigen gevonden met de geselecteerde filters.</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
