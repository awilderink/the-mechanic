---
import { getTeamMembers, urlFor } from "../../sanity";
import type { TeamSection } from "../../sanity/types";
import TeamCarousel, { type TeamMemberCard } from "../../solid/TeamCarousel";
import Title from "../Title.astro";

interface Props {
  block: TeamSection;
}

const { block } = Astro.props;
const teamMembers = await getTeamMembers();

const filteredMembers =
  block.members?.map((member) => {
    return teamMembers.find((teamMember) => teamMember._id === member._ref);
  }) || [];

const members: TeamMemberCard[] = filteredMembers.flatMap((member) =>
  member?.afbeelding
    ? [
        {
          naam: member.naam ?? "",
          functie: member.functie ?? "",
          bio: member.bio ?? "",
          image: {
            src: urlFor(member.afbeelding)
              .width(960)
              .height(720)
              .quality(75)
              .format("webp")
              .url(),
            alt: member.naam || "Team member",
            width: 960,
            height: 720,
          },
        },
      ]
    : [],
);
---

<section class="bg-sand py-16">
  <div class="container max-w-6xl mx-auto px-4">
    <Title variant="tertiary" class="text-neutral-600">Team</Title>
    {block.title && <div class="mt-2 text-2xl">{block.title}</div>}
    {members.length > 0 && <TeamCarousel client:visible members={members} />}
  </div>
</section>
