---
import type { ReviewsSection } from "../../sanity/types";
import ReviewsCarousel, { type Review } from "../../solid/ReviewsCarousel";
import SanityImage from "../SanityImage.astro";
import Title from "../Title.astro";

interface Props {
  block: ReviewsSection;
}

const { block } = Astro.props;

const reviews: Review[] =
  block.reviews?.map(({ naam, body }) => ({
    naam: naam ?? "",
    body: body ?? "",
  })) || [];
---

<section class="overflow-hidden px-4 py-14">
  <div class="container mx-auto max-w-6xl">
    <div class="flex gap-6 flex-col md:flex-row">
      <SanityImage
        class="basis-full md:basis-2/5 rounded-xl w-full h-auto object-cover"
        image={block.image?.asset}
        width={448}
        height={640}
      />
      <div class="bg-sand basis-3/5 p-8 flex flex-col gap-4 rounded-xl">
        <Title variant="tertiary" class="text-neutral-600">Testimonials</Title>
        <ReviewsCarousel client:visible reviews={reviews} />
      </div>
    </div>
  </div>
</section>
