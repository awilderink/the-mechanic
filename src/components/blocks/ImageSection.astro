---
import { urlFor } from '../../sanity/index.ts';
import type { ImageSection } from '../../sanity/types';
import GalleryMain from '../../solid/GalleryMain';
import GalleryThumbs from '../../solid/GalleryThumbs';
import type { Img } from '../../solid/types';
import SanityImage from '../SanityImage.astro';

interface Props {
  block: ImageSection
}

const { block } = Astro.props;
// Only needs to be unique per rendered block; both islands receive this value.
const galleryId = crypto.randomUUID();
const entries = block.images || [];
const hasMultipleImages = entries.length > 1;

const images: Img[] = entries
  .filter((entry) => entry.image)
  .map((entry) => ({
    src: urlFor(entry.image!).width(1600).height(1000).quality(75).format('webp').url(),
    alt: entry.alt || '',
    width: 1600,
    height: 1000,
  }));
---

{
  entries.length > 0 && (
    <section class="py-16 px-4">
      <div class="container mx-auto max-w-6xl">
        {hasMultipleImages ? (
          <>
            <div class="relative h-96 overflow-hidden rounded-lg sm:h-[500px] lg:h-[600px]">
              <GalleryMain client:visible galleryId={galleryId} images={images} />
            </div>
            <div class="mt-2">
              <GalleryThumbs
                client:visible
                galleryId={galleryId}
                images={images}
                thumbBasis="basis-20"
              />
            </div>
          </>
        ) : (
          <SanityImage
            format="webp"
            quality={75}
            image={entries[0].image}
            alt={entries[0].alt || ""}
            class="h-auto w-full rounded-lg"
          />
        )}
      </div>
    </section>
  )
}
