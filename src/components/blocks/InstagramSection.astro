---
import { getInstagramPosts } from "../../instagram";
import type { InstagramSection } from "../../sanity/types";
import { socials } from "../../socials";
import Button from "../Button.astro";
import Icon from "../Icon.astro";
import Title from "../Title.astro";

interface Props {
  block: InstagramSection;
}

const { block } = Astro.props;
const posts = await getInstagramPosts(block.limit ?? 6);
const profileUrl =
  socials.find((social) => social.icon === "instagram")?.href ??
  "https://www.instagram.com/";

const altFor = (caption: string) =>
  caption ? caption.split("\n")[0].slice(0, 120) : "Instagram-bericht van The Mechanic";
---

<section class="bg-sand px-4 py-14">
  <div class="container mx-auto max-w-6xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <Title variant="tertiary" class="text-gray-400">Instagram</Title>
        {block.title && <div class="mt-2 text-2xl">{block.title}</div>}
        {block.intro && <p class="mt-2 max-w-xl font-light">{block.intro}</p>}
      </div>
      <a href={profileUrl} target="_blank" rel="noopener noreferrer">
        <Button size="sm" variant="primary" class="flex items-center gap-2">
          <Icon name="instagram" class="size-6" />
          Volg ons
        </Button>
      </a>
    </div>
    {
      posts.length > 0 && (
        <div class="mt-8 grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-4">
          {posts.map((post) => (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-square overflow-hidden rounded-xl bg-white"
            >
              <img
                src={post.image}
                alt={altFor(post.caption)}
                width="600"
                height="600"
                loading="lazy"
                class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              {post.isVideo && (
                <span class="absolute top-3 right-3 flex size-8 items-center justify-center rounded-full bg-black/50 text-white">
                  <Icon name="play" class="size-4" />
                </span>
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
