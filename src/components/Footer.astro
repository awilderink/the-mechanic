---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import { socials } from '../socials';
import Icon from './Icon.astro';

const directLinks = [
	{ label: 'Werkplaats', href: '/werkplaats' },
	{ label: 'Diensten', href: '/diensten' },
	{ label: 'Aanbod', href: '/voorraad' },
	{ label: 'Over ons', href: '/wie-we-zijn' },
];

const legalLinks = [
	{
		label: 'Algemene voorwaarden',
		href: '/algemene-voorwaarden-bovag.pdf',
		external: true,
	},
	{ label: 'Disclaimer', href: '/disclaimer' },
	{ label: 'Privacyverklaring', href: '/privacyverklaring' },
];
---

<footer class="bg-gray-700 px-4 py-10 text-white md:py-16 font-light">
  <div
    class="container mx-auto flex max-w-6xl flex-col justify-between gap-10 md:flex-row"
  >
    <div>
      <Image
        src="/logo_emblem.svg"
        alt="Logo of The Mechanic"
        height="1"
        width="200"
      />
      <div class="mt-6 text-sm leading-loose">
        Van Leijdenstraat 2C<br />
        2277 AW Voorburg
      </div>
      <div class="mt-6 space-x-1 [&>*]:inline-block">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
            >
              <Icon name={social.icon} class="size-7" />
            </a>
          ))
        }
      </div>
      <div class="mt-12 flex flex-col gap-2">
        <a href="tel:+31708209890">
          <Button variant="outline" size="sm" class="flex items-center">
            <Icon name="phone" class="mr-2 inline-block h-5" />
            070 8209890
          </Button>
        </a>
        <a href="mailto:info@themechanic.nl">
          <Button variant="outline" size="sm" class="flex items-center">
            <Icon name="email" class="mr-2 inline-block h-5" />
            info@themechanic.nl
          </Button>
        </a>
      </div>
    </div>
    <div>
      <div class="font-semibold">Direct naar</div>
      <div class="mt-4 space-y-2 [&>*]:block">
        {directLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
    <div>
      <div class="font-semibold">Openingstijden</div>
      <table class="mt-4 [&_td]:py-1 [&_td+td]:pl-4">
        <tr id="monday">
          <td>Maandag</td>
          <td>08:00 - 17:00</td>
        </tr>
        <tr id="tuesday">
          <td>Dinsdag</td>
          <td>08:00 - 17:00</td>
        </tr>
        <tr id="wednesday">
          <td>Woensdag</td>
          <td>08:00 - 17:00</td>
        </tr>
        <tr id="thursday">
          <td>Donderdag</td>
          <td>08:00 - 17:00</td>
        </tr>
        <tr id="friday">
          <td>Vrijdag</td>
          <td>08:00 - 17:00</td>
        </tr>
        <tr id="saturday">
          <td>Zaterdag</td>
          <td>Variërend*</td>
        </tr>
        <tr id="sunday">
          <td>Zondag</td>
          <td>Gesloten</td>
        </tr>
      </table>
    </div>
    <div class="mt-auto space-y-4">
      <img src="/rdw.svg" alt="RDW" height="1" width="100" />
      <img src="/bovag.svg" alt="Bovag" height="1" width="100" />
    </div>
  </div>
  <div
    class="container mx-auto mt-12 flex max-w-6xl flex-col gap-2 border-t border-white/20 pt-6 text-sm text-white/80 md:flex-row md:flex-wrap md:gap-x-6"
  >
    {
      legalLinks.map((link) => (
        <a
          href={link.href}
          class="hover:text-white"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button
      type="button"
      class="cursor-pointer text-left hover:text-white"
      onclick="document.dispatchEvent(new CustomEvent('cookie-preferences:open'))"
    >
      Cookievoorkeuren
    </button>
  </div>
</footer>
<script>
  const today = new Date();
  const nameOfDay = today.toLocaleDateString("en-GB", { weekday: "long" });
  const day = document.getElementById(nameOfDay.toLowerCase());
  if (day) day.classList.add("font-semibold");
</script>
